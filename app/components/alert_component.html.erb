<div
  x-data="{ open: true }"
  x-show="open"
  <% if role %>role="<%= role %>"<% end %>
  <% if title_id %>aria-labelledby="<%= title_id %>"<% end %>
  class="<%= class_names("cfa-alert flex items-start gap-cfa-sm rounded border border-border-primary bg-background-tertiary p-cfa-med text-text-primary", @css_class) %>"
>
  <%# Without a title: the icon and the text's first 20px line are both centered 16px down, so they line up with each other at any text length, and a single line centers on the 32px action button. %>
  <span class="<%= class_names("flex shrink-0 items-center", "md:h-8" => center_content?) %>">
    <%= inline_icon(icon_name, size: 24, css_class: "text-text-primary", aria_hidden: true) %>
  </span>
  <div class="<%= class_names("flex flex-1 min-w-0 flex-col gap-cfa-sm md:flex-row md:justify-between md:gap-cfa-med", (dismissible || center_content?) ? "md:items-center" : "md:items-end") %>">
    <div class="<%= class_names("flex-1 min-w-0 cfa-stack-xsm", "md:py-1.5" => center_content?) %>">
      <% if title.present? %>
        <p class="type-body-bold" <% if title_id %>id="<%= title_id %>"<% end %>><%= title %></p>
      <% end %>
      <p><%= content %></p>
    </div>
    <% if actions? %>
      <div class="cfa-alert__actions flex shrink-0 flex-wrap gap-cfa-sm">
        <% actions.each do |action| %>
          <%= action %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if dismissible %>
    <%# -m-1: 32px hit area in a 24px layout slot. Focus ring is a border because Safari doesn't paint a negative outline-offset. %>
    <button
      type="button"
      @click="open = false"
      class="<%= class_names("-m-1 flex size-8 shrink-0 items-center justify-center cursor-pointer rounded-sm bg-transparent border-2 border-transparent p-0 text-inherit hover:bg-primary active:bg-button-primary-fill-active focus-visible:outline-none focus-visible:border-focus", "md:self-center" => actions?) %>"
      aria-label="<%= t("cfaui.alert.dismiss_aria") %>"
    >
      <%= inline_icon(:close, size: 24, aria_hidden: true) %>
    </button>
  <% end %>
</div>

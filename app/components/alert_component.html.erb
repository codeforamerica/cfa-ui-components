<div
  x-data="{ open: true }"
  x-show="open"
  role="alert"
  class="<%= class_names("cfa-alert flex items-start gap-2.5 rounded border border-border-secondary bg-background-tertiary p-cfa-med text-text-default", @css_class) %>"
>
  <span class="flex shrink-0 items-center">
    <%= inline_icon(icon_name, size: 24, css_class: "text-icon-default", aria_hidden: true) %>
  </span>
  <%# Mobile: actions stack under the text. md+: actions sit inline, bottom-aligned with the text. %>
  <div class="flex flex-1 min-w-0 flex-col gap-2.5 md:flex-row md:items-end md:justify-between md:gap-cfa-med">
    <div class="flex-1 min-w-0 cfa-stack-xsm">
      <% if title.present? %>
        <p class="type-body-bold"><%= title %></p>
      <% end %>
      <p><%= content %></p>
    </div>
    <% if actions? %>
      <div class="cfa-alert__actions flex shrink-0 flex-wrap gap-cfa-sm">
        <% actions.each do |action| %>
          <%= action %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if dismissible %>
    <button
      type="button"
      @click="open = false"
      class="flex size-8 shrink-0 items-center justify-center cursor-pointer bg-transparent border-0 p-0 text-inherit focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
      aria-label="<%= t("cfaui.alert.dismiss_aria") %>"
    >
      <%= inline_icon(:close, size: 24, aria_hidden: true) %>
    </button>
  <% end %>
</div>

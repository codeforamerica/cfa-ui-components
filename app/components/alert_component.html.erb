<div
  x-data="{ open: true }"
  x-show="open"
  role="alert"
  class="<%= class_names("cfa-alert flex items-start gap-2.5 rounded border border-border-primary bg-background-tertiary p-cfa-med text-text-primary", @css_class) %>"
>
  <span class="flex shrink-0 items-center">
    <%# Figma's icon/default (#121212) matches text/primary; the global icon-default token is #011E29. %>
    <%= inline_icon(icon_name, size: 24, css_class: "text-text-primary", aria_hidden: true) %>
  </span>
  <%# Mobile: actions stack under the text. md+: actions sit inline with the text —
      bottom-aligned, or vertically centered (alongside the dismiss button) when dismissible. %>
  <div class="<%= class_names("flex flex-1 min-w-0 flex-col gap-2.5 md:flex-row md:justify-between md:gap-cfa-med", dismissible ? "md:items-center" : "md:items-end") %>">
    <div class="flex-1 min-w-0 cfa-stack-xsm">
      <% if title.present? %>
        <p class="type-body-bold"><%= title %></p>
      <% end %>
      <p><%= content %></p>
    </div>
    <% if actions? %>
      <div class="cfa-alert__actions flex shrink-0 flex-wrap gap-cfa-sm">
        <% actions.each do |action| %>
          <%= action %>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if dismissible %>
    <%# Figma lays out a 24px icon; -m-1 keeps the 32px hit area without shifting layout.
        md+ with actions: centered so it sits beside the action buttons. %>
    <button
      type="button"
      @click="open = false"
      class="<%= class_names("-m-1 flex size-8 shrink-0 items-center justify-center cursor-pointer bg-transparent border-0 p-0 text-inherit focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus", "md:self-center" => actions?) %>"
      aria-label="<%= t("cfaui.alert.dismiss_aria") %>"
    >
      <%= inline_icon(:close, size: 24, aria_hidden: true) %>
    </button>
  <% end %>
</div>
